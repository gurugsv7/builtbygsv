# Base URL of the BuiltbyGSV API worker (worker/). Leave empty to disable online
# enquiries and analytics; the site then falls back to email and WhatsApp.
# Examples: https://builtbygsv-api.<account>.workers.dev or https://api.builtbygsv.in
VITE_API_BASE=

# Set to true to send analytics from localhost while testing.
VITE_ANALYTICS_DEBUG=false
